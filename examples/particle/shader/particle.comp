#version 450
// Workgroup width is a specialization constant (id 0) instead of a literal: the
// host can trade register pressure for fewer dispatches at runtime, and the
// default below keeps a pipeline that never overrides it working unchanged.
// The guard against gl_GlobalInvocationID.x is what makes a non-divisor width
// safe -- without it the tail workgroup would read/write past the SSBO.
layout(constant_id = 0) const uint LOCAL_SIZE_X = 256u;
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    vec4 position;
    vec4 velocity;
    vec4 color;
};
// deltaTime in seconds, particleCount so a partial tail workgroup exits early.
layout(set = 0, binding = 0) uniform Params { float deltaTime; uint particleCount; uint pad0; uint pad1; } params;
layout(std430, set = 0, binding = 1) readonly buffer InputParticles { Particle inParticles[]; };
layout(std430, set = 0, binding = 2) writeonly buffer OutputParticles { Particle outParticles[]; };

// Deterministic integer hash -> [0, 1).  Used for the respawn spread so the
// fountain looks alive without a random seed buffer.
float hash01(uint x) {
    x = (x ^ 61u) ^ (x >> 16);
    x *= 9u;
    x ^= x >> 4;
    x *= 0x27d4eb2du;
    x ^= x >> 15;
    return float(x & 0x00ffffffu) / 16777216.0;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.particleCount) {
        return;
    }
    Particle p = inParticles[i];
    p.velocity.y -= 1.8 * params.deltaTime;
    p.position += p.velocity * params.deltaTime;
    if (p.position.y < -1.2) {
        // Respawn at the top instead of bouncing with a decaying velocity: the
        // old bounce let every particle settle onto the floor and collapse into
        // one thin band a couple of seconds after start-up, leaving the frame
        // (almost) empty.  The column is deliberately narrow and the horizontal
        // velocity is proportional to it, so the cloud fans out into a fountain
        // cone instead of covering the whole viewport with confetti.
        float rx = hash01(i * 2u + 1u) * 2.0 - 1.0;
        float ry = hash01(i * 2u + 13u);
        float rz = hash01(i * 2u + 7u) * 0.8 - 0.4;
        p.position = vec4(rx * 0.25, 1.0 + ry * 0.25, rz, 1.0);
        p.velocity = vec4(rx * 0.5, 0.6 + ry * 0.6, 0.0, 0.0);
    }
    outParticles[i] = p;
}
