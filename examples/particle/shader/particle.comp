#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    vec4 position;
    vec4 velocity;
    vec4 color;
};
layout(set = 0, binding = 0) uniform Params { float deltaTime; float padding[3]; } params;
layout(std430, set = 0, binding = 1) readonly buffer InputParticles { Particle inParticles[]; };
layout(std430, set = 0, binding = 2) writeonly buffer OutputParticles { Particle outParticles[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    Particle p = inParticles[i];
    p.velocity.y -= 1.8 * params.deltaTime;
    p.position += p.velocity * params.deltaTime;
    if (p.position.y < -1.5) {
        p.position.y = 1.5;
        p.velocity.y = abs(p.velocity.y) * 0.6;
    }
    outParticles[i] = p;
}
