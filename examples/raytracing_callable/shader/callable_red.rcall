#version 460
#extension GL_EXT_ray_tracing : require

layout(location = 0) callableDataInEXT vec3 outColor;

void main()
{
    // Horizontal stripes: brightness only, so the dominant channel stays red.
    const float stripe = mod(float(gl_LaunchIDEXT.y / 16u), 2.0);
    outColor = vec3(0.95, 0.18, 0.12) * mix(0.80, 1.0, stripe);
}
