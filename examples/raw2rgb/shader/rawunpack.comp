#version 450
// Unpack 12-bit RAW (two 12-bit samples per uint32 word) into 16-bit samples
// packed two-per-word: each output uint32 holds two left-aligned 16-bit values.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer RawImage { uint raw[]; };
layout(std430, set = 0, binding = 1) writeonly buffer UnpackedImage { uint unpacked[]; };
layout(push_constant) uniform Params { uint width; uint height; } params;

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint totalWords = (params.width * params.height) / 2u;
    if (index >= totalWords) return;
    uint word = raw[index];
    uint a = (word & 0x00000FFFu) << 4u;
    uint b = (word >> 12u) << 4u;
    unpacked[index] = a | (b << 16u);
}
