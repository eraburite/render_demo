#version 460
#extension GL_EXT_ray_query : require

// Ray query instead of a ray tracing pipeline: the whole trace -- primary AND
// shadow ray -- runs inside one compute shader through rayQueryEXT.  There is no
// SBT, no shader group and no traceRayEXT; the acceleration structure is just a
// descriptor the shader queries.
//
// The reference sample (Vulkan-Samples `rayquery`) rasterises the scene and does
// the query in the fragment stage.  This port keeps the mechanism and the hybrid
// shape -- raster-style camera, analytic shading, ray-query shadows -- but runs it
// in a compute shader, because the example-side descriptor atlas has no
// acceleration-structure component and adding one would change the shared raster
// path (see DESIGN.md 31.7).

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, rgba8) uniform image2D outImage;
layout(binding = 2, set = 0) uniform CameraProperties
{
    mat4 viewInverse;
    mat4 projInverse;
    vec4 flags; // x = shadow rays enabled
} cam;

layout(binding = 3, set = 0) readonly buffer Materials
{
    vec4 materialData[]; // two vec4 per instance: albedo.rgb, then reflectivity
} materials;

layout(binding = 4, set = 0) readonly buffer Positions
{
    vec4 position[];
} positions;

layout(binding = 5, set = 0) readonly buffer Normals
{
    vec4 normal[];
} normals;

layout(binding = 6, set = 0) readonly buffer Indices
{
    uint index[];
} indices;

// Deliberately oblique: a near-vertical light hides every shadow under the
// block that casts it, which would make the A/B check meaningless.
const vec3 kLightDirection = vec3(0.95, 0.40, 0.25);

// Reconstructs the triangle the committed hit landed on.  A ray query has no
// closest-hit shader to fetch attributes for it, so the vertex / index buffers
// double as the geometry source.
vec3 WorldNormal(mat4x3 objectToWorld, uint instance, uint primitive, vec3 barycentric)
{
    const uint base = 3u * primitive;
    const uint i0 = indices.index[base + 0u];
    const uint i1 = indices.index[base + 1u];
    const uint i2 = indices.index[base + 2u];

    const vec3 p0 = objectToWorld * vec4(positions.position[i0].xyz, 1.0);
    const vec3 p1 = objectToWorld * vec4(positions.position[i1].xyz, 1.0);
    const vec3 p2 = objectToWorld * vec4(positions.position[i2].xyz, 1.0);

    vec3 worldNormal = normalize(cross(p1 - p0, p2 - p0));
    const vec3 objectNormal = normals.normal[i0].xyz * barycentric.x
                            + normals.normal[i1].xyz * barycentric.y
                            + normals.normal[i2].xyz * barycentric.z;
    // The instance transforms use non-uniform scale, so the cross product above is
    // the only reliable world-space normal; the buffer normal only decides the
    // sign.
    if (dot(worldNormal, objectNormal) < 0.0) {
        worldNormal = -worldNormal;
    }
    return worldNormal;
}

void main()
{
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(outImage);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    const vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    // glm::perspective is +Y up, image row 0 is the top row (see DESIGN.md 31.5).
    const vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);

    const vec3 origin = (cam.viewInverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    const vec4 target = cam.projInverse * vec4(ndc.x, ndc.y, 1.0, 1.0);
    const vec3 direction = normalize((cam.viewInverse * vec4(normalize(target.xyz / target.w), 0.0)).xyz);

    vec3 color = vec3(0.0);

    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, origin, 0.001, direction, 10000.0);
    // No candidate loop: opaque triangles need no any-hit decision, so the query
    // commits on its own.
    while (rayQueryProceedEXT(query)) {
    }

    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        // Sky gradient, same shape as the RT examples so the two can be compared.
        const float t = 0.5 * (direction.y + 1.0);
        color = mix(vec3(0.06, 0.08, 0.14), vec3(0.42, 0.50, 0.72), t);
    } else {
        const uint instance = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(query, true));
        const uint primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(query, true));
        const float t = rayQueryGetIntersectionTEXT(query, true);
        const vec2 attribs = rayQueryGetIntersectionBarycentricsEXT(query, true);
        const vec3 barycentric = vec3(1.0 - attribs.x - attribs.y, attribs.x, attribs.y);
        const mat4x3 objectToWorld = rayQueryGetIntersectionObjectToWorldEXT(query, true);

        const vec3 worldNormal = WorldNormal(objectToWorld, instance, primitive, barycentric);
        const vec3 albedo = materials.materialData[2u * instance].rgb;
        const vec3 hitPosition = origin + direction * t;

        float visibility = 1.0;
        if (cam.flags.x > 0.5) {
            // The shadow ray: terminate on the first hit, because only "is
            // anything in the way" matters.
            rayQueryEXT shadowQuery;
            rayQueryInitializeEXT(shadowQuery, topLevelAS,
                                  gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFF,
                                  hitPosition + worldNormal * 0.002, 0.001, normalize(kLightDirection), 10000.0);
            while (rayQueryProceedEXT(shadowQuery)) {
            }
            if (rayQueryGetIntersectionTypeEXT(shadowQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
                visibility = 0.0;
            }
        }

        const float nDotL = max(dot(worldNormal, normalize(kLightDirection)), 0.0);
        color = albedo * (0.18 + 0.82 * nDotL * visibility);
    }

    imageStore(outImage, pixel, vec4(color, 1.0));
}
